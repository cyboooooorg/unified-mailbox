# Unified Mailbox server configuration.
# Copy this file to .env in the directory the server runs from. A
# variable set in the real environment wins over this file. Every line
# below shows the default: uncomment it to change the value.

# Directory of the database and, by default, of the key file.
# DATA_DIR=./data

# Secret key that encrypts the account tokens in the database. Back it
# up apart from the database.
# KEY_FILE=./data/secret.key

# Change nothing in the mailboxes, except actions the user confirmed.
# DRY_RUN=true

# Spam or phishing confidence (0 to 100) at or above which a mail goes
# to the junk folder.
# SPAM_THRESHOLD=90

# Never send to junk a mail from a known sender that passed DMARC.
# PROTECT_KNOWN_SENDERS=true

# Comma-separated tag keys whose mails are archived once classified,
# such as newsletter,promotion.
# ARCHIVE_CATEGORIES=

# Log filter (tracing-subscriber EnvFilter syntax), such as
# info,sqlite=debug.
# RUST_LOG=info
