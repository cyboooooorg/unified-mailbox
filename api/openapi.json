{
  "openapi": "3.1.0",
  "info": {
    "title": "Unified Mailbox API",
    "description": "API of the Unified Mailbox server. Every route but /health and /pairing requires a per-device bearer token.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/devices": {
      "get": {
        "summary": "Lists the devices not revoked, oldest first.",
        "operationId": "list_devices",
        "responses": {
          "200": {
            "description": "The active devices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/pairing-codes": {
      "post": {
        "summary": "Creates a one-time pairing code, valid ten minutes.",
        "operationId": "create_pairing_code",
        "responses": {
          "201": {
            "description": "A new code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingCodeDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{id}": {
      "delete": {
        "summary": "Revokes a device, the caller included: its token stops working.",
        "operationId": "revoke_device",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Device id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or already revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "Streams the server's events as server-sent events.",
        "description": "The stream starts with `retry: 3000`, then sends each event as one\n`data:` line holding an `EventDto` as JSON, and a `: ping` comment when\nidle. It ends when the caller's device is revoked (its reconnection then\ngets a 401), after a `resync` event, and when the server shuts down.\n\nThe client reads it with `fetch` and the bearer token (`EventSource`\ncannot send the header). On every connect and reconnect, and on every\n`resync` event, it reloads what it shows (and `GET /jobs/{id}` for a job\nit follows): events only tell what changed since. After `resync` the\nstream ends: the client reconnects.",
        "operationId": "stream_events",
        "responses": {
          "200": {
            "description": "A stream of server-sent events: `retry: 3000` first, then one `data:` line per event holding an `EventDto` as JSON, and a `: ping` comment when idle",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Liveness probe; needs no token.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "The server is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/jobs": {
      "get": {
        "summary": "Lists the running jobs, oldest first.",
        "operationId": "list_jobs",
        "responses": {
          "200": {
            "description": "The running jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "summary": "Returns one job, running or finished.",
        "operationId": "get_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pairing": {
      "post": {
        "summary": "Pairs a new device with a one-time code; needs no token.",
        "operationId": "pair_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Paired; the token is shown only here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown, used or expired code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Body is not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Malformed body or invalid name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/settings/language": {
      "get": {
        "summary": "Returns the language the user chose, `null` when they have not.",
        "operationId": "get_language",
        "responses": {
          "200": {
            "description": "The chosen language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LanguageSettingDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Chooses the language; every client is told through the event stream.",
        "operationId": "set_language",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LanguageUpdateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The language now chosen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LanguageSettingDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Body is not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Malformed body or unknown language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceDto": {
        "type": "object",
        "description": "A paired device that is not revoked.",
        "required": [
          "id",
          "name",
          "created_at",
          "last_seen_at",
          "current"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "Whether this is the device that made the request."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Always present, `null` until the device is first seen. Updated at\nmost once a minute."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The error body of every non-2xx response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Machine-readable error code, stable across versions.",
        "enum": [
          "invalid_pairing_code",
          "unauthorized",
          "not_found",
          "method_not_allowed",
          "payload_too_large",
          "unsupported_media_type",
          "invalid_request",
          "internal"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English; not meant to be parsed."
          }
        }
      },
      "EventDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "A job was created, progressed or finished.",
            "required": [
              "job",
              "type"
            ],
            "properties": {
              "job": {
                "$ref": "#/components/schemas/JobDto"
              },
              "type": {
                "type": "string",
                "enum": [
                  "job"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A device was revoked: a hint to reload the device list.",
            "required": [
              "device_id",
              "type"
            ],
            "properties": {
              "device_id": {
                "type": "integer",
                "format": "int64"
              },
              "type": {
                "type": "string",
                "enum": [
                  "device_revoked"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The settings changed: reload them.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "settings_changed"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The subscriber missed events: reload what is shown. The stream ends\nright after it; reconnect.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "resync"
                ]
              }
            }
          }
        ],
        "description": "One event of the stream, the JSON of a `data:` line, tagged by `type`.",
        "discriminator": {
          "propertyName": "type"
        }
      },
      "HealthDto": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "description": "Server version."
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "JobDto": {
        "type": "object",
        "description": "A long operation and its progress.",
        "required": [
          "id",
          "kind",
          "status",
          "done",
          "failed",
          "total",
          "error",
          "created_at",
          "finished_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "done": {
            "type": "integer",
            "format": "int64",
            "description": "Items processed with success.",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Always present, `null` unless the job failed."
          },
          "failed": {
            "type": "integer",
            "format": "int64",
            "description": "Items that failed.",
            "minimum": 0
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Always present, `null` while the job runs."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatusDto"
          },
          "total": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Always present, `null` while the number of items is unknown.",
            "minimum": 0
          }
        }
      },
      "JobStatusDto": {
        "type": "string",
        "description": "Where a job stands.",
        "enum": [
          "running",
          "succeeded",
          "failed",
          "interrupted"
        ]
      },
      "LanguageDto": {
        "type": "string",
        "description": "A language the interface and Claude's text can be in.",
        "enum": [
          "en",
          "fr"
        ]
      },
      "LanguageSettingDto": {
        "type": "object",
        "description": "The language the user chose.",
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LanguageDto",
                "description": "Always present, `null` until the user chooses one; the client then\nfollows its own locale."
              }
            ]
          }
        }
      },
      "LanguageUpdateDto": {
        "type": "object",
        "description": "The language to choose.",
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "$ref": "#/components/schemas/LanguageDto"
          }
        }
      },
      "PairingCodeDto": {
        "type": "object",
        "description": "A one-time pairing code, to show to the person pairing a new device.",
        "required": [
          "code",
          "expires_at"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "`XXXX-XXXX`, Crockford base32."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PairingRequest": {
        "type": "object",
        "description": "A pairing request from a new device.",
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The one-time pairing code, as typed: case, spaces and hyphens do\nnot matter."
          },
          "name": {
            "type": "string",
            "description": "The new device's name: trimmed, 1 to 64 characters, no control\ncharacter."
          }
        }
      },
      "PairingResponse": {
        "type": "object",
        "description": "The new device and its bearer token, returned only here, only once.",
        "required": [
          "device_id",
          "token"
        ],
        "properties": {
          "device_id": {
            "type": "integer",
            "format": "int64"
          },
          "token": {
            "type": "string",
            "description": "`um_` then 43 base64url characters. Send it as\n`Authorization: Bearer <token>`."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-device token obtained by pairing"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
